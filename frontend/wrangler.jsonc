{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swipah",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "swipah.com",
      "custom_domain": true
    },
    {
      "pattern": "www.swipah.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
